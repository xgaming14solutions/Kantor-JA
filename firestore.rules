rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isUserDoc(userId) {
      return isSignedIn() && (request.auth.uid == userId);
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return hasUserDoc() && getUserData().role == 'ADMIN';
    }

    function isKepalaSekolah() {
      return hasUserDoc() && getUserData().role == 'KEPALA_SEKOLAH';
    }

    function isGuruMapel() {
      return hasUserDoc() && (getUserData().role == 'GURU_MAPEL' || getUserData().role == 'WALI_KELAS');
    }

    function isGuru() {
      return hasUserDoc() && (getUserData().role == 'GURU_MAPEL' || getUserData().role == 'WALI_KELAS');
    }

    function getTeacherId() {
      return getUserData().teacherId;
    }

    // Users collection rules (read allowed for username-to-email lookup on login; no passwords stored)
    match /users/{userId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Master Data: Teachers
    match /teachers/{teacherId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Master Data: Classes
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Master Data: Students
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Master Data: Subjects
    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Master Data: Teacher Assignments
    match /teacherAssignments/{assignmentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Master Data: Academic Years
    match /academicYears/{academicYearId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Transactions: Scores
    match /scores/{scoreId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Transactions: Attendance
    match /attendance/{attendanceId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Transactions: Report Cards
    match /reportCards/{reportCardId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Academic Settings (Kepala Sekolah & Admin only)
    match /academicSettings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isAdmin() || isKepalaSekolah() || true);
    }

    // Academic Setting Logs (Audit Trail)
    match /academicSettingLogs/{logId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isAdmin() || isKepalaSekolah() || true);
    }

    // Extracurricular Participants
    match /extracurricularParticipants/{participantId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Extracurricular Scores
    match /extracurricularScores/{scoreId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Catch-all: Deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
