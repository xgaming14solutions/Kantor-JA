{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Akun pengguna sistem KantoJA dengan role dan relasi guru",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID" },
        "username": { "type": "string", "description": "Username unik untuk login", "maxLength": 50 },
        "email": { "type": "string", "format": "email", "description": "Email resmi pengguna" },
        "displayName": { "type": "string", "description": "Nama lengkap pengguna", "maxLength": 150 },
        "name": { "type": "string", "description": "Nama lengkap pengguna", "maxLength": 150 },
        "role": {
          "type": "string",
          "enum": ["ADMIN", "KEPALA_SEKOLAH", "WALI_KELAS", "GURU_MAPEL", "KEPALA_KESANTRIAN", "MUSYRIF_KESANTRIAN", "kepala_kesantrian", "musyrif_kesantrian", "PETUGAS_KESANTRIAN"],
          "description": "Hak akses otorisasi sistem"
        },
        "kesantrianRole": {
          "type": "string",
          "enum": ["KEPALA_KESANTRIAN", "MUSYRIF_KESANTRIAN"],
          "description": "Peran spesifik petugas Kesantrian (Kepala Kesantrian atau Musyrif Kesantrian)"
        },
        "teacherId": { "type": "string", "description": "Relasi ID ke master data teachers", "maxLength": 128 },
        "nip": { "type": "string", "maxLength": 30 },
        "phone": { "type": "string", "maxLength": 30 },
        "avatarUrl": { "type": "string" },
        "isActive": { "type": "boolean", "description": "Status keaktifan akun" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "username", "email", "displayName", "role", "isActive"]
    },
    "Teacher": {
      "title": "Teacher",
